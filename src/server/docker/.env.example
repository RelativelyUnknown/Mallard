# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
#
# Placeholders: every CHANGE_ME value below is deliberately invalid — the server
# refuses to start while INFLUX_TOKEN / API_KEYS / MQTT_PASSWORD (or the other
# secret settings) still contain CHANGE_ME. Generate real ones with e.g.
#   openssl rand -hex 32
# Values that only docker compose reads (INFLUX_ADMIN_PASSWORD,
# GF_SECURITY_ADMIN_PASSWORD) are left blank: compose refuses to start until
# you set them.
#
# Credentials live in this file by default (SECRET_MANAGER_TYPE=static) — the
# base stack runs on its own:
#   docker compose -f docker-compose.yml up -d
# For live credential rotation without restarts, add the OpenBao overlay:
#   docker compose -f docker-compose.yml -f docker-compose.openbao.yml up -d
# See docs/guide/secret-management.md.

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUX_ADMIN_USER=admin
# REQUIRED — set a strong password (compose refuses to start while blank).
INFLUX_ADMIN_PASSWORD=
INFLUX_TOKEN=CHANGE_ME_influx_api_token
INFLUX_ORG=mallard
INFLUX_BUCKET=metrics

# ── Mallard server ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RATE_LIMIT=60/minute
# Reverse proxies whose X-Forwarded-For the pre-auth rate limiter trusts
# (IPs/CIDRs, comma-separated). The compose default covers the Docker bridge
# ranges Caddy connects from; set explicitly if your network differs.
# TRUSTED_PROXIES=172.16.0.0/12
# Serve FastAPI's interactive /docs + /redoc (off by default; recon surface).
# ENABLE_DOCS=false
# Optional: shared Redis for the per-credential rate limiter. Needed only when
# running multiple server replicas (the k8s deployment sets this); a single
# Docker instance can leave it empty and use the in-process limiter.
# REDIS_URL=redis://redis:6379/0

# ── Grafana ───────────────────────────────────────────────────────────────────
# REQUIRED — set a strong password (compose refuses to start while blank).
GF_SECURITY_ADMIN_PASSWORD=
# Served under /grafana (Caddy proxies it; Grafana runs with a sub-path root URL).
# Defaults to https://$SERVER_DOMAIN/grafana — override only for a custom setup.
# GF_SERVER_ROOT_URL=https://mallard.example.com/grafana
# Grafana only reads — give it a READ-ONLY InfluxDB token scoped to the metrics
# bucket, never INFLUX_TOKEN (the admin token). After first boot create one with:
#   docker compose exec influxdb influx auth create \
#     --org mallard --read-bucket metrics --description "grafana read-only"
# then paste the token here and restart Grafana. See ../docs/grafana-token.md.
# (Must be non-empty for compose to start at all, so it ships as a placeholder;
# until replaced Grafana simply gets 401s from InfluxDB.)
GRAFANA_INFLUX_TOKEN=CHANGE_ME_read_only_influx_token

# ── Caddy TLS ─────────────────────────────────────────────────────────────────
# Leave SERVER_DOMAIN=localhost for a self-signed dev cert.
# Set to your real hostname + ACME_EMAIL for automatic Let's Encrypt.
SERVER_DOMAIN=localhost
ACME_EMAIL=

# ── MQTT (optional) ───────────────────────────────────────────────────────────
# Set MQTT_ENABLED=true to start the embedded MQTT broker inside the server
# container. Extensions connect via wss://your-server/mqtt.
MQTT_ENABLED=false
MQTT_PORT=8083

# ── Credentials (static backend — the default) ────────────────────────────────
#   API_KEYS      "label:secret" pairs, comma-separated — the label becomes the
#                 InfluxDB source tag (Bearer tokens verify against this too)
#   MQTT_PASSWORD single shared broker password; all MQTT ingest is source='mqtt'
#   CERT_LABELS   "label:cn" pairs mapping an mTLS client-cert CN to a source
#                 label; unmapped CNs fall back to the CN itself
#   WEBHOOK_HMAC_SECRETS
#                 comma-separated HMAC signing secrets for
#                 X-Mallard-Signature-256 verification; empty disables signing.
#                 List old+new during rotation.
# With the OpenBao overlay these are the *initial* values openbao-init seeds
# into OpenBao's KV store on first boot; rotate through OpenBao afterward.
API_KEYS=team-alpha:CHANGE_ME_api_key_1,team-beta:CHANGE_ME_api_key_2
MQTT_PASSWORD=CHANGE_ME_mqtt_broker_password
CERT_LABELS=
WEBHOOK_HMAC_SECRETS=

# ── OpenBao overlay only ──────────────────────────────────────────────────────
# Dev overlay only (see docker-compose.openbao.yml). Blank = built-in dev token.
OPENBAO_DEV_ROOT_TOKEN=
